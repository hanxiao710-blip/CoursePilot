# CoursePilot — Supabase environment variables
# Copy this file to .env.local and fill in your project's values.
# NEVER commit .env.local to git.

# From your Supabase project dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ── DO NOT add your service_role key, JWT secret, or database password here ──
# Those are server-side secrets and must never appear in frontend code.
