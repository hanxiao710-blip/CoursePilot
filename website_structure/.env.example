# CoursePilot — environment variables
# Copy this file to .env.local and fill in your project's values.
# NEVER commit .env.local to git.

# ── Supabase (frontend, safe to expose) ──────────────────────────────────
# From your Supabase project dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Gemini API (server-side only — NEVER use a VITE_ prefix here) ────────
# Used by the /api/extract-syllabus Vercel serverless function.
# Get a key from https://aistudio.google.com/app/apikey
# In production: set this in the Vercel dashboard under
#   Project → Settings → Environment Variables → GEMINI_API_KEY
# Do NOT put a VITE_ prefix — that would expose the key to the browser.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: override the default model (gemini-3.1-flash-lite)
# GEMINI_MODEL=gemini-3.1-flash-lite

# ── DO NOT add your service_role key, JWT secret, or database password here ──
# Those are server-side secrets and must never appear in frontend code.
